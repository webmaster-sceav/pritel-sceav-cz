---

import { Image, } from 'astro:assets';
import { contentfulClient } from "../../lib/contentful";
import type { Asset, AssetDetails, EntryFieldsSetFilter, EntryFieldTypes, OrderFilterPaths } from "contentful";

interface PritelPosts {
  contentTypeId: "pritel",
  fields: {
    title: EntryFieldTypes.Text,
    slug: EntryFieldTypes.Text,
    publishedAt: EntryFieldTypes.Date,
    summary: EntryFieldTypes.RichText,
    tableOfContents: EntryFieldTypes.Object,
    pdfFile: EntryFieldTypes.AssetLink,
    thumbnail: EntryFieldTypes.AssetLink,

  }
}

const entries = await contentfulClient.getEntries<PritelPosts>({
  content_type: "pritel",
});

const posts = entries.items.map( ( item ) => {

    const { title, slug, publishedAt, summary, tableOfContents, pdfFile, thumbnail } = item.fields;
    const formatter = new Intl.DateTimeFormat('cs', { month: 'long' });
    const monthName = formatter.format(new Date( publishedAt ));
    const year = publishedAt.split("-")[0];
    const link = (pdfFile as Asset)?.fields?.file?.url as string;
    const thumbnailAsset = (thumbnail as Asset);
    const thumbnaillUrl = thumbnailAsset.fields.file?.url as string;
    const thumbnailWidth = (thumbnailAsset?.fields?.file?.details as AssetDetails)?.image?.width ?? 0;
    const thumbnailHeight = (thumbnailAsset?.fields?.file?.details as AssetDetails)?.image?.height ?? 0;

    return {
        title,
        slug,
        monthName,
        year,
        link,
        thumbnailWidth,
        thumbnailHeight,
        thumbnaillUrl,
    }; 
})

const thumbDir = '../../assets/thumbnails/';

const thumbnailGrid: { 
    month: string; 
    year: string; 
    img: string; 
    link: string; 
    imgData?: () => Promise<{default: ImageMetadata}>,
}[] = [
    {
        month: "Červenec",
        year: "2025",
        img: thumbDir + "Pritel_2025_01.pdf.png",
        link: "/r/pritel-1-2025",
    },
    {
        month: "Červen",
        year: "2025",
        img: thumbDir + "Pritel_2025_06.pdf.png",
        link: "",
    },
    {
        month: "Květen",
        year: "2025",
        img: thumbDir + "Pritel_2025_05.pdf.png",
        link: "",
    },
    {
        month: "Duben",
        year: "2025",
        img: thumbDir + "Pritel_2025_04.pdf.png",
        link: "",
    },
    {
        month: "Březen",
        year: "2025",
        img: thumbDir + "Pritel_2025_03.pdf.png",
        link: "",
    },
    {
        month: "Únor",
        year: "2025",
        img: thumbDir + "Pritel_2025_02.pdf.png",
        link: "",
    },
];


const images = import.meta.glob<{ default: ImageMetadata }>( '../../assets/thumbnails/' + '*.png' );

thumbnailGrid.map( 
    ( item ) => {
        return item.imgData = images[item.img] ?? null;
    }
)

