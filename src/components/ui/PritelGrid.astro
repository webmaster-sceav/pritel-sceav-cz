---

import { Image, } from 'astro:assets';
import { GET } from '../../pages/api/getEntries.ts';
import LoadMoreBtn from '../ui/LoadMoreBtn.astro';

const res = await GET( Astro );
const posts = await res.json();


---

   

    <div id="pritelGrid" class="grid lg:grid-cols-4 grid-cols-1 gap-2 lg:px-20 px-8 ">
        {
            posts.map( 
                ( tile: { 
                    monthName: string; 
                    year: string; 
                    slug: string; 
                    thumbnailUrl: string; 
                    thumbnailWidth: number; 
                    thumbnailHeight: number; 
                    }, 
                    index: number 
                ) => (
            ( index === 0 ) 
            ?
            <tile class="bg-amber-500 pb-4">
                <heading class="mb-4 flex justify-between">
                    <div class="px-4 py-2 font-semibold capitalize"> { tile.monthName } </div>
                    <div class="rounded-bl-md bg-stone-800 px-4 py-2 text-white"> { tile.year } </div>
                </heading>
                <div class="flex h-[calc(100%-3rem)] items-center justify-center px-4">
                    <div class="relative w-full aspect-[4/3]">
                        <a href={ '/r/' + tile.slug }>
                        {
                            tile.thumbnailUrl 
                            ?
                            <Image 
                                src={ tile.thumbnailUrl } 
                                width={ tile.thumbnailWidth} 
                                height={ tile.thumbnailHeight } 
                                alt="" 
                                class="object-scale-down w-max opacity-0 transition-opacity duration-300" 
                            />
                            :
                            "Thumbnail"
                        }
                        </a>
                    </div>
                </div>
            </tile>
            :
                <tile class="bg-stone-200 pb-4">
                    <heading class="mb-4 flex justify-between">
                        <div class="px-4 py-2 font-semibold capitalize"> { tile.monthName } </div>
                        <div class="rounded-bl-md bg-stone-800 px-4 py-2 text-white"> { tile.year } </div>
                    </heading>
                    <div class="flex h-[calc(100%-3rem)] items-center justify-center px-4">
                        <div class="relative w-full aspect-[4/3]">
                            {
                                tile.thumbnailUrl 
                                ?
                                <Image 
                                    src={ tile.thumbnailUrl } 
                                    width={ tile.thumbnailWidth} 
                                    height={ tile.thumbnailHeight } 
                                    alt="" 
                                    onload="this.classList.remove('opacity-0'); this.nextElementSibling?.remove()"
                                    class="object-scale-down w-max opacity-0 transition-opacity duration-300" 
                                />
                                <div class="spinner absolute inset-0 flex items-center justify-center animate-pulse bg-stone-200 z-10">
                                    <span class="text-gray-500">Načítám...</span>
                                </div>
                                :
                                "Thumbnail"
                            }
                            
                        </div>
                    </div>
                </tile>               
            ))
            
        }

         <LoadMoreBtn />

    </div>