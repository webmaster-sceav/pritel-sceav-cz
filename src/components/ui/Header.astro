---
const { isMainPage = true } = Astro.props;
---

    <header class="max-w-7xl mx-auto px-8 lg:px-20 pt-12 pb-24 flex flex-col items-center text-center relative z-10">
        {isMainPage &&
        <a href="https://sceav.cz" class="mb-8 opacity-80 hover:opacity-100 transition-opacity">
            <span class="text-sm font-bold tracking-widest uppercase text-slate-400">← Zpět na SCEAV.cz</span>
        </a>
        }

        <h1 class="font-black text-6xl md:text-8xl text-slate-800 dark:text-white mb-4 tracking-tight">
            PŘÍTEL
        </h1>
        <p class="text-xl md:text-2xl font-medium text-slate-500 dark:text-slate-400 max-w-2xl">
            Časopis Slezské církve evangelické a. v.
        </p>
        <div class="mt-8 h-1 w-24 bg-sceav-blue rounded-full"></div>
    </header>