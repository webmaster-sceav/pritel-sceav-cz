<div id="MoreBtn" class="flex flex-col justify-center items-center p-8 bg-slate-100 dark:bg-slate-800/50 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 cursor-pointer hover:bg-slate-200 dark:hover:bg-slate-800 hover:border-sceav-blue transition-all">
    <div class="w-12 h-12 bg-white dark:bg-slate-700 rounded-full flex items-center justify-center mb-3 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
    </div>
    <span class="font-semibold text-slate-600 dark:text-slate-300">Načíst další čísla</span>
</div>

<script>

    const moreBtn = document.getElementById("MoreBtn");
    let skip = 7;
    const limit = 8;
    
    moreBtn?.addEventListener("click", async (event) => {
        
        function noMoreNews(){
            if ( pritelGrid && moreBtn ) {
                pritelGrid.innerHTML += ` <p>Žádná další čísla</p> `;
                moreBtn.classList.add("hidden");
            }
        }

        function showNews(){

            if ( ! pritelGrid ) return;

            news.map(( tile, index) => {
                const newTile = document.createElement( "tile" );
                newTile.setAttribute( 'key', index.toString() );
                newTile.classList.add('bg-stone-200', 'pb-4');
                newTile.innerHTML = 
                    `
                        <heading class="mb-4 flex justify-between">
                            <div class="px-4 py-2 font-semibold capitalize"> ${ tile.monthName } </div>
                            <div class="rounded-bl-md bg-stone-800 px-4 py-2 text-white"> ${ tile.year } </div>
                        </heading>
                        <div class="flex h-[calc(100%-3rem)] items-center justify-center px-4">
                            <div class="bg-red-800 aspect-[4/3]">
                                <a href='/r/${ tile.slug }'>
                                    <div class="spinner absolute inset-0 flex items-center justify-center animate-pulse bg-stone-200 z-10">
                                        <span class="text-gray-500">Načítám...</span>
                                    </div>
                                    <img 
                                        src=${ tile.thumbnailUrl } 
                                        width=${ tile.thumbnailWidth} 
                                        height=${ tile.thumbnailHeight } 
                                        alt="" 
                                        class="object-scale-down w-max opacity-0 transition-opacity duration-300" 
                                    />
                                </a>
                            </div>
                        </div>
                `;

                const img = newTile.querySelector("img");
                const spinner = newTile.querySelector(".spinner");

                (img && spinner ) && img.addEventListener("load", () => {
                    newTile.classList.remove("spinner");
                    img.classList.remove("opacity-0");
                    spinner.remove(); // remove the spinner once loaded
                });
                pritelGrid.insertBefore ( newTile, moreBtn );
            })
        }

        // news-list is loaded as server:defer so this component might not be available on load, delaying query until click event
        const pritelGrid = document.getElementById("pritelGrid");
        
        if ( !pritelGrid ) return;

        event.preventDefault();
        

        const response = await fetch (
            '/api/getEntries?' + new URLSearchParams(
                {
                    skip: skip.toString(),
                })
                .toString()
        );

        if ( response.status === 200 ){
            var news: Array<{ 
                        monthName: string; 
                        year: string; 
                        slug: string; 
                        thumbnailUrl: string; 
                        thumbnailWidth: number; 
                        thumbnailHeight: number; 
                        }> = await response.json();
            //console.log(news)

            news?.length ? showNews() : noMoreNews();
            skip += limit;

        } else {

            pritelGrid.innerHTML += ` <p>Nepodařilo se načíst čísla</p> `;

        }

        return false;
    })

</script>