---


const tiles = [

    {
        title: "Redakce Přítele - Przyjaciela",
        lines: [
            "Na Nivách 259/7",
            "737 01 Český Těšín",
            "tel.: 558 764 380",
            "e-mail: pritel@sceav.cz",
        ],
    },
    {
        title: "Vedoucí a zást. vedoucího redaktora",
        lines: [
            "Mgr. Janusz Kożusznik",
            "Mgr. Vlastimil Ciesar",
        ],
    },
    {
        title: "Redakční rada",
        lines: [
            "Mgr. Roman Brzezina",
            "Mgr. Vladislav Volný, Th.D.",
            "Milan Zielina, DiS.",
        ],
    },
    {
        title: "Jazyková korektura",
        lines: [
            "Mgr. Pavlína Volná",
            "Mgr. Janusz Kożusznik",
        ],
    },
    {
        title: "Technická redakce",
        lines: [
            "Milan Zielina, DiS.",
        ],
    },
    {
        title: "Grafická úprava a sazba",
        lines: [
            "Ing. Jindřich Novák",
        ],
    },        
];

---

<div class="lg:px-20 px-8">
    <div class="mb-8 text-3xl font-black text-stone-800">
        Kontakty
    </div>
    <div class="grid lg:grid-cols-3 grid-cols-1 gap-2">

        {
            tiles.map( ( tile, index ) => (
            ( index % 2 === 0 )

            ?

            <ul class="bg-stone-800 text-white p-8 rounded-lg">
                <li class="font-semibold mb-2">{ tile.title }</li>
                {
                    tile.lines.map( ( line, index ) => (
                        <li class="font-light"> { line }</li>
                    ))
                }
            </ul>

            :

            <ul class="bg-white p-8 border rounded-lg">
                <li class="font-semibold mb-2">{ tile.title }</li>
                {
                    tile.lines.map( ( line, index ) => (
                        <li class="font-light"> { line }</li>
                    ))
                }
            </ul>

            ))
        }
    </div>
</div>