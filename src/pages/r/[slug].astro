---
export const prerender = false;

import "../../styles/global.css";
import BaseLayout from "../../layout/Base.astro";
import { Image } from "astro:assets";
import { contentfulClient } from "../../lib/contentful";
import { downloadQuery, isActiveReaderCode, issuePaywall, normalizeReaderCode, readerCodeCookie } from "../../lib/paywall";
//import { documentToHtmlString } from "@contentful/rich-text-html-renderer";
import { changeWhitespacetoNbsp } from '../../lib/textPreprocessor';

import type {
    Asset,
    AssetDetails,
    EntryFieldTypes,
} from "contentful";

interface PritelPosts {
    contentTypeId: "pritel";
    fields: {
        title: EntryFieldTypes.Text;
        slug: EntryFieldTypes.Text;
        publishedAt: EntryFieldTypes.Date;
        summary: EntryFieldTypes.Text; //EntryFieldTypes.RichText;
        tableOfContents: EntryFieldTypes.Object<[{ title: string, page: number, author: string, }]>;
        pdfFile: EntryFieldTypes.AssetLink;
        thumbnail: EntryFieldTypes.AssetLink;
    };
}

const { slug } = Astro.params;

let post;

try {
    const entries = await contentfulClient.getEntries<PritelPosts>({
        content_type: "pritel",
        "fields.slug": slug,
    });
    const { title, publishedAt, summary, tableOfContents, pdfFile, thumbnail } =
        entries.items[0].fields;
    const formatter = new Intl.DateTimeFormat("cs", { month: "long" });
    const thumbnailAsset = thumbnail as Asset;

    post = {
        title: title,
        publishedAt,
        summary: changeWhitespacetoNbsp( summary ),
        monthName: formatter.format(new Date(publishedAt)) ?? "",
        year: publishedAt.split("-")[0] ?? "",
        toc: tableOfContents,
        link: (pdfFile as Asset)?.fields?.file?.url as string,
        thumbnaillUrl: thumbnailAsset.fields.file?.url as string,
        thumbnailWidth:
            (thumbnailAsset?.fields?.file?.details as AssetDetails)?.image
                ?.width ?? 0,
        thumbnailHeight:
            (thumbnailAsset?.fields?.file?.details as AssetDetails)?.image
                ?.height ?? 0,
        
    };

} catch (error) {
    return Astro.redirect("/404");
}

const issuedYears = new Date().getFullYear() - 1947;
const paywall = issuePaywall(post.publishedAt);
const issuePath = Astro.url.pathname;
const checksDownload = Astro.url.searchParams.get(downloadQuery) === '1';
const isCodeSubmission = Astro.request.method === 'POST';
const privateResponse = Boolean(paywall) || checksDownload || isCodeSubmission;
const downloadHref = paywall ? `${issuePath}?${downloadQuery}=1` : post.link;
let canDownload = !paywall;
let codeError = '';

function redirectWithoutCache(location: string) {
    return new Response(null, {
        status: 303,
        headers: { Location: location, 'Cache-Control': 'private, no-store' },
    });
}

if (paywall) {
    const code = normalizeReaderCode(isCodeSubmission
        ? (await Astro.request.formData()).get('code')
        : Astro.cookies.get(readerCodeCookie)?.value);

    try {
        canDownload = await isActiveReaderCode(code);
    } catch {
        Astro.response.status = 503;
        codeError = 'Kód se nepodařilo ověřit. Zkuste to prosím později.';
    }

    if (isCodeSubmission && !codeError) {
        if (canDownload && code) {
            Astro.cookies.set(readerCodeCookie, code, {
                path: '/r',
                httpOnly: true,
                sameSite: 'lax',
                secure: Astro.url.protocol === 'https:',
                maxAge: 366 * 24 * 60 * 60,
            });
            return redirectWithoutCache(issuePath);
        }

        Astro.response.status = 403;
        codeError = 'Tento kód není platný pro aktuální rok.';
    }
} else if (isCodeSubmission) {
    return redirectWithoutCache(issuePath);
}

if (checksDownload && !isCodeSubmission && !codeError) {
    if (!canDownload) return redirectWithoutCache(issuePath);
    if (!post.link) return new Response(null, { status: 404 });
    return redirectWithoutCache(new URL(post.link, Astro.url).href);
}

---

<BaseLayout isMainPage={false} privateResponse={privateResponse}>
    <main class="max-w-7xl mx-auto px-8 lg:px-20 mb-32">

        <a
            href="/"
            class="inline-flex items-center gap-2 mb-8 text-slate-500 hover:text-sceav-blue dark:text-slate-400 dark:hover:text-blue-400 font-medium transition-colors"
        >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Zpět
        </a>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            
            <div class="lg:col-span-5 lg:sticky lg:top-8">
                <div class="relative group mx-auto max-w-[500px] lg:max-w-none">
                    <div class="absolute -inset-1 bg-gradient-to-tr from-sceav-blue to-blue-600 rounded-[1.5rem] opacity-20 blur-lg group-hover:opacity-40 transition-opacity duration-500"></div>
                    
                    <div class="relative aspect-[210/297] rounded-2xl overflow-hidden shadow-2xl border border-slate-100 dark:border-slate-700 bg-white dark:bg-slate-800">
                    <Image
                        src={ post.thumbnaillUrl }
                        alt=""
                        width={ post.thumbnailWidth }
                        height={ post.thumbnailHeight }
                        class="object-scale-down w-max" 
                    />
                    </div>
                </div>

                <div class="mt-8 flex flex-col gap-4 max-w-[500px] mx-auto lg:max-w-none">
                    {canDownload && downloadHref ? <a href={ downloadHref }
                       target="_blank"
                       class="flex items-center justify-center gap-3 w-full py-4 px-6 bg-red-600 hover:bg-red-700 text-white text-lg font-bold rounded-xl shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        Stáhnout PDF
                    </a> : paywall ? <form method="post" action={issuePath} class="flex flex-col gap-3">
                        <label for="reader-code" class="flex items-center gap-2 font-bold">
                            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 10V7a5 5 0 0 1 10 0v3M6 10h12a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2Z" />
                            </svg>
                            Předplatitelský kód
                        </label>
                        <input id="reader-code" name="code" type="text" required maxlength="40"
                            autocapitalize="characters" autocomplete="off" spellcheck="false"
                            aria-describedby={codeError ? 'reader-code-date reader-code-error' : 'reader-code-date'}
                            class="rounded-xl border border-slate-400 bg-white px-4 py-3 dark:border-slate-500 dark:bg-slate-800" />
                        {codeError && <p id="reader-code-error" role="alert" class="text-red-700 dark:text-red-300">{codeError}</p>}
                        <button type="submit" class="w-full rounded-xl bg-red-600 px-6 py-4 text-lg font-bold text-white shadow-lg hover:bg-red-700">
                            Odemknout PDF
                        </button>
                        <p id="reader-code-date" class="text-center text-sm text-slate-600 dark:text-slate-300">Volně dostupné od {paywall.opensOn}.</p>
                    </form> : <p class="text-center text-sm">PDF zatím není k dispozici.</p>}
                    {canDownload && downloadHref && <p class="text-center text-sm text-slate-400">Formát PDF • Velikost cca 5 MB</p>}
                </div>
            </div>

            <div class="lg:col-span-7">
                
                <div class="border-b border-slate-300 dark:border-slate-700 pb-8 mb-8">
                    <div class="flex items-center gap-4 mb-4">
                        <!--
                        <span class="px-4 py-1.5 bg-sceav-blue/10 text-sceav-darkblue dark:text-blue-200 rounded-full text-sm font-bold uppercase tracking-wider">
                            Číslo 01
                        </span>
                         -->
                        <span class="px-4 py-1.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-full text-sm font-bold">
                            Ročník {issuedYears}
                        </span>
                    </div>
                    
                    <h1 class="text-5xl md:text-6xl font-black text-slate-800 dark:text-white mb-2 capitalize">
                        { post.monthName } <span class="text-slate-400 dark:text-slate-600">{ post.year }</span>
                    </h1>
                </div>

                <div class="prose prose-lg dark:prose-invert text-slate-600 dark:text-slate-300 leading-relaxed mb-12">
                    <p>{ post?.summary }</p>
                </div>

                <div class="bg-white dark:bg-slate-800 rounded-2xl p-8 shadow-sm border border-slate-100 dark:border-slate-700">
                    <h3 class="text-xl font-bold mb-6 flex items-center gap-2 text-slate-800 dark:text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-sceav-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                        </svg>
                        Obsah čísla
                    </h3>
                    
                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3">
                        {
                            Array.isArray(post.toc) && 
                            post.toc.map((item ) => (
                                <li class="flex items-start gap-3 py-2 border-b border-slate-100 dark:border-slate-700/50 last:border-0">
                                <span class="text-sceav-blue mt-1.5">•</span>
                                <span class="text-slate-700 dark:text-slate-300 font-medium">{ item?.title }</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>

            </div>
        </div>

    </main>
</BaseLayout>
        

